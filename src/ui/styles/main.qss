/* 主窗口样式 */
QMainWindow {
    background: #1a1a2e;
}

/* 分组框样式 */
QGroupBox {
    border: 2px solid #00d4ff;
    border-radius: 8px;
    background: #252526;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    color: #00d4ff;
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* 开始按钮 */
QPushButton#start {
    background: #4CAF50;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#start:disabled {
    background: #555;
    color: #888;
}

/* 停止按钮 */
QPushButton#stop {
    background: #f44336;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#stop:disabled {
    background: #555;
    color: #888;
}

/* 截图按钮 */
QPushButton#screenshot {
    background: #FF9800;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#screenshot:hover {
    background: #FFB74D;
}

QPushButton#screenshot:pressed {
    background: #F57C00;
}

/* 加载大地图按钮 */
QPushButton#loadbigmap {
    background: #9C27B0;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#loadbigmap:hover {
    background: #AB47BC;
}

QPushButton#loadbigmap:pressed {
    background: #7B1FA2;
}

/* 通用按钮样式 */
QPushButton {
    background: #3a3a3a;
    color: white;
    border: 1px solid #00d4ff;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 13px;
}

QPushButton:hover {
    background: #4a4a4a;
}

/* 下拉框样式 */
QComboBox {
    background-color: #2a2a2a;
    border: 2px solid #555;
    border-radius: 6px;
    padding: 6px 10px;
    color: white;
    min-width: 80px;
    font-weight: bold;
    font-size: 13px;
}

QComboBox:hover {
    background-color: #3a3a3a;
    border: 2px solid #00d4ff;
}

QComboBox:on {
    background-color: #00d4ff;
    color: #000000;
    border: 2px solid #00d4ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
    border-left: 1px solid #555;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #2a2a2a;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #00d4ff;
    margin: 0 0 0 8px;
}

QComboBox:hover::drop-down {
    background-color: #3a3a3a;
    border-left: 1px solid #00d4ff;
}

QComboBox:on::down-arrow {
    border-top: 6px solid #000000;
}

/* 下拉框列表样式 */
QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    border: 2px solid #00d4ff;
    border-radius: 8px;
    padding: 6px;
    outline: none;
    selection-background-color: #00d4ff;
    selection-color: #000000;
    alternate-background-color: #1e1e2e;
}

QComboBox QAbstractItemView::item {
    background-color: #1e1e2e;
    color: #ffffff;
    padding: 10px 16px;
    min-height: 32px;
    border-radius: 6px;
    margin: 2px 0;
    font-size: 13px;
    font-weight: bold;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #00d4ff;
    color: #000000;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #00d4ff;
    color: #000000;
    font-weight: bold;
}

QComboBox QAbstractItemView::item:alternate {
    background-color: #1e1e2e;
}

/* 标签样式 */
QLabel {
    color: white;
}

/* 文本编辑框样式 */
QTextEdit {
    background: #0a0a0a;
    color: #00d4ff;
    border: 1px solid #333;
    font-family: Consolas;
    font-size: 11px;
}

/* 状态栏样式 */
QStatusBar {
    background: #252526;
    border-top: 1px solid #00d4ff;
    color: white;
}

QStatusBar::item {
    border: none;
}
